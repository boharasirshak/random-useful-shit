# Copy to .env. Every value has a working default for local dev with `docker compose up db redis -d`.
DATABASE_URL=postgresql+asyncpg://app:app@localhost:5432/app
REDIS_URL=redis://localhost:6379/0
# Comma-separated Google OAuth client IDs whose ID tokens we accept (iOS, Android, web). Empty = Google sign-in off.
GOOGLE_CLIENT_IDS=
# Needed for admin routes (RAG ingest). Long random string: python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_TOKEN=
CORS_ORIGINS=*
