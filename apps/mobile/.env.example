# Copy to .env and fill in. OAuth client IDs from Google Cloud Console (APIs & Services → Credentials).
# Not secret (they ship in the app), but keep your real .env out of git.
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
# Optional: the shared server (apps/server). Every tool's data syncs to it; Unrot also gets new cards and related ideas.
# On a phone, use your Mac's LAN IP, e.g. http://192.168.1.20:8000. Leave empty to stay fully offline.
EXPO_PUBLIC_API_URL=
# Optional: where the full food database lives (packages/food-data/upload.mjs prints it), e.g. https://<app>.ufs.sh/f
EXPO_PUBLIC_FOOD_DATA_URL=
# Optional: where Unrot's published cards live (packages/unrot-content/upload.mjs prints it)
EXPO_PUBLIC_UNROT_DATA_URL=
# One base URL for all published data (food database, Unrot cards, ambient tracks); the two above are older names for the same thing
EXPO_PUBLIC_DATA_URL=
